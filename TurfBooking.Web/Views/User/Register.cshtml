@model TurfBooking.BusinessLayer.Model.User

@{
    ViewData["Title"] = "Register";
}

<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4 rounded-3" style="width: 400px;">
        <h2 class="text-center mb-4">Create an Account</h2>

        <form asp-action="Register" method="post">
            <div class="mb-3">
                <label class="form-label fw-bold">Full Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter your full name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="Enter your email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Phone Number</label>
                <input asp-for="PhoneNumber" type="number" class="form-control" placeholder="Enter your phone number" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Create a password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Register</button>

            <div class="text-center mt-3">
                <small>Already have an account? <a class="text-decoration-none" asp-area="" asp-controller="User" asp-action="Login">Login here</a></small>
            </div>
        </form>
    </div>
</div>

